---
layout: layouts/base.njk
title: Båden
permalink: /baaden/
---
{% import "partials/macros.njk" as m with context %}
{{ m.hero(baaden.top) }}

<section class="section" id="indhold">
  <div class="container stack">
    {% for a in baaden.afsnit %}{{ m.split(a, loop.index0 % 2) }}{% endfor %}
  </div>
</section>

{% if baaden.indenfor %}
<section class="section section--sand" id="indenfor">
  <div class="container">
    <div class="center narrow reveal">
      <h2>{{ baaden.indenfor.overskrift }}</h2>
      {% if baaden.indenfor.tekst %}<div class="prose lead">{{ baaden.indenfor.tekst | md | safe }}</div>{% endif %}
    </div>
    {% if baaden.indenfor.grundplan %}
      <figure class="floorplan reveal">
        <button class="floorplan__btn" data-lightbox="{{ baaden.indenfor.grundplan | url }}" aria-label="Vis grundplanen større">{{ m.media(baaden.indenfor.grundplan, "Grundplan over Mango") }}</button>
        {% if baaden.indenfor.grundplan_tekst %}<figcaption>{{ baaden.indenfor.grundplan_tekst }}</figcaption>{% endif %}
      </figure>
    {% endif %}
    {% if baaden.indenfor.billeder.length %}
      <div class="interior">
        {% for b in baaden.indenfor.billeder %}
          <figure class="interior__item reveal{% if loop.first %} interior__item--big{% endif %}" style="--d:{{ (loop.index0 % 4) * 70 }}ms">
            <button data-lightbox="{{ b.billede | url }}" aria-label="Vis billede større">{{ m.media(b.billede, b.tekst) }}</button>
            {% if b.tekst %}<figcaption>{{ b.tekst }}</figcaption>{% endif %}
          </figure>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if baaden.tal %}
<section class="section section--navy">
  <div class="container">
    <h2 class="center reveal">{{ baaden.tal.overskrift }}</h2>
    <div class="specs">
      {% for t in baaden.tal.liste %}
        <div class="spec reveal" style="--d:{{ (loop.index0 % 4) * 70 }}ms">
          <span class="spec__label">{{ t.navn }}</span>
          <span class="spec__value">{{ t.vaerdi }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    {{ m.split(baaden.bygget) }}
  </div>
</section>

{% if baaden.galleri.billeder.length %}
<section class="section section--sand">
  <div class="container">
    <h2 class="center reveal">{{ baaden.galleri.overskrift }}</h2>
    <div class="gallery">
      {% for img in baaden.galleri.billeder %}
        <button class="gallery__item reveal" data-lightbox="{{ img | url }}" aria-label="Vis billede større">{{ m.media(img, "") }}</button>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{{ m.cta("Spørgsmål til båden?", baaden.afslutning.tekst) }}
